# ============================================================
#  Neural Agorà Control - variabili d'ambiente
#  Copia questo file in .env e compila i valori.
#  Il file .env NON va mai caricato su GitHub.
# ============================================================

# --- Chiave interna del gateway LiteLLM (inventala tu, es. sk-qualcosa-di-lungo)
LITELLM_MASTER_KEY=sk-cambiami-con-una-stringa-lunga

# --- Password del database di LiteLLM (inventala tu, lunga, senza spazi e senza @ : /)
LITELLM_DB_PASSWORD=cambiami-password-database

# --- Ollama (locale)
# Se Ollama gira sul tuo PC fuori da Docker (consigliato su Windows):
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Modelli a pagamento (facoltativi: senza chiavi il Capo usa solo il locale)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Il budget massimo mensile si imposta in litellm/config.yaml (max_budget)
#     ed è applicato grazie al database

# --- RunPod Serverless (facoltativo: per immagini e video)
RUNPOD_API_KEY=
RUNPOD_IMAGE_ENDPOINT_ID=
RUNPOD_VIDEO_ENDPOINT_ID=

# --- Il Capo
# Chiave che Open WebUI usa per parlare con il Capo (inventala tu, lunga).
# Senza, chiunque sulla tua rete potrebbe usare il Capo e i tuoi crediti.
CAPO_API_KEY=cambiami-chiave-del-capo
# Indirizzo da cui il browser vede immagini e video generati.
# Da usare con Tailscale: http://<nome-del-pc>.<tailnet>.ts.net:8100
CAPO_PUBLIC_URL=http://localhost:8100

# --- Interfaccia web
WEBUI_SECRET_KEY=cambiami-anche-questa
